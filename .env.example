# Đặt biến trong shell; file này chỉ là mẫu, Python không tự đọc .env.
export PROVIDER=openrouter
export MODEL=openai/gpt-6-luna
export OPENROUTER_API_KEY=YOUR_KEY
# Với OpenAI trực tiếp, đổi PROVIDER=openai và MODEL=gpt-6-luna.
# export OPENAI_API_KEY=YOUR_KEY
# API tương thích OpenAI: đặt URL gốc nếu không gọi api.openai.com.
# export OPENAI_BASE_URL=https://opencode.ai/inference/go/openai/v1
# export MODEL=deepseek-v4.1-flash
# export GEMINI_API_KEY=YOUR_KEY
# export ANTHROPIC_API_KEY=YOUR_KEY
